// 紹介特典管理アプリのデータモデル
// 開発時は SQLite。本番で PostgreSQL を使う場合は provider を "postgresql" に変更する。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 校舎（日野校・日宇校・大野校・佐々校 など）
model Campus {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  sortOrder    Int           @default(0)
  active       Boolean       @default(true)
  referrals    Referral[]
  applications Application[]
}

// 特典コード（紹介カード1枚＝1レコード）
// スプレッドシート「管理表」の1行に相当する
model Referral {
  id              Int           @id @default(autoincrement())
  code            String        @unique // カードに印字された招待コード（例: 109135）
  campusId        Int
  campus          Campus        @relation(fields: [campusId], references: [id])
  enrollmentType  String? // 通常入会 / 講習会申込み（lib/constants.ts の ENROLLMENT_TYPES）
  studentName     String? // 職員入力: 特典を受け取る生徒名（塾生）
  referredName    String? // 職員入力: 紹介されて入塾・講習申込した方の氏名
  staffName       String? // 担当者名
  distributedAt   DateTime? // 校舎配布日
  enrolledAt      DateTime? // 入塾日・講習申込日
  paidAt          DateTime? // 入金日
  amazonOrderedAt DateTime? // Amazon ギフトコード発注日
  giftCode        String? // Amazon ギフトコード
  giftSentAt      DateTime? // ギフトコードをメール送信した日時
  note            String? // 備考
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  applications    Application[]

  @@index([campusId])
}

// 保護者からの申込み（Google フォーム「紹介特典」の回答に相当）
model Application {
  id            Int       @id @default(autoincrement())
  referralId    Int
  referral      Referral  @relation(fields: [referralId], references: [id])
  campusId      Int
  campus        Campus    @relation(fields: [campusId], references: [id])
  studentName   String // 生徒名（塾生）
  guardianName  String // 保護者名
  email         String
  address       String
  phone         String
  referredGrade String // ご紹介した方の学年
  referredName  String // ご紹介した方の氏名
  confirmedAt   DateTime? // 職員が内容を確認した日時
  createdAt     DateTime  @default(now())

  @@index([referralId])
}
