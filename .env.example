# ---- データベース（Supabase / リージョン: Tokyo ap-northeast-1） ----
# <PROJECT_REF> と <DB_PASSWORD> は Supabase の値に置き換える（docs/DEPLOY.md 参照）
# ホスト名（aws-0- / aws-1- など）は Supabase の Connect 画面に表示されるものに合わせる
# アプリ用: Transaction pooler（6543）
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# マイグレーション用: Session pooler（5432）
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ---- ログイン ----
# 経理用ログインパスワード（校舎担当者のパスワードは管理画面で校舎ごとに設定）
ADMIN_PASSWORD="change-me"
# セッション署名用の秘密鍵（32文字以上のランダム文字列。openssl rand -base64 32 など）
SESSION_SECRET="dev-secret-please-change-to-a-long-random-string"

# ---- 公開 URL ----
# QR コード用 URL の表示に使用。未設定ならアクセス中のホスト名
# APP_URL="https://referral.example.com"

# ---- 通知メール（GAS 経由で社用 Gmail から送信。設定手順は gas/README.md） ----
# 未設定の場合は送信せずサーバーログに出力する
# GAS_MAIL_URL="https://script.google.com/macros/s/xxxxxxxx/exec"
# GAS_MAIL_SECRET=""
