DATABASE_URL="file:./dev.db"
# 経理用ログインパスワード（校舎担当者のパスワードは管理画面で校舎ごとに設定）
ADMIN_PASSWORD="change-me"
# セッション署名用の秘密鍵（16文字以上のランダム文字列）
SESSION_SECRET="dev-secret-please-change-to-a-long-random-string"
# 公開URL（QRコード用URLの表示に使用。未設定ならアクセス中のホスト名）
# APP_URL="https://referral.example.com"

# 期限切れ通知メール（SMTP）。未設定の場合は送信せずサーバーログに出力する
# Gmail の場合: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=<アドレス> SMTP_PASS=<アプリパスワード>
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="智翔館 <no-reply@example.com>"
